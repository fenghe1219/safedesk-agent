# Copy to .env for local development.
APP_ENV=development
DEMO_MODE=true
SEED_DEMO=true
SECRET_KEY=dev-only-change-me

# Docker Compose database defaults
POSTGRES_DB=safedesk
POSTGRES_USER=safedesk
POSTGRES_PASSWORD=safedesk

# Backend
DATABASE_URL=postgresql+psycopg://safedesk:safedesk@localhost:5432/safedesk
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# Frontend server -> backend (inside Docker use http://api:8000)
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SafeDesk

# Optional OpenAI-compatible model provider. Leave LLM_PROVIDER=disabled for
# the offline extractive baseline. Ollama example:
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_MODEL=qwen2.5:7b
LLM_PROVIDER=disabled
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
LLM_TIMEOUT_SECONDS=30
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=1200
LLM_INPUT_COST_PER_MILLION=0
LLM_OUTPUT_COST_PER_MILLION=0
AGENT_MAX_MODEL_CALLS=2
