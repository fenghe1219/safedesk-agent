# Copy to .env for local development.
APP_ENV=development
DEMO_MODE=true
SEED_DEMO=true
SECRET_KEY=dev-only-change-me

# Docker Compose database defaults
POSTGRES_DB=safedesk
POSTGRES_USER=safedesk
POSTGRES_PASSWORD=safedesk

# Backend
DATABASE_URL=postgresql+psycopg://safedesk:safedesk@localhost:5432/safedesk
SESSION_COOKIE_SECURE=false
CORS_ORIGINS=["http://localhost:3000"]

# Frontend server -> backend (inside Docker use http://api:8000)
API_INTERNAL_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=SafeDesk
